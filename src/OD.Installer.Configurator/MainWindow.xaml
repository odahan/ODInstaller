<Window x:Class="OD.Installer.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OD Installer - Configuration" Width="860" Height="740" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Click="New_Click" InputGestureText="Ctrl+N" />
        <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O" />
        <Separator />
        <MenuItem x:Name="RecentFilesMenu" Header="_Recent" SubmenuOpened="RecentFilesMenu_SubmenuOpened" />
        <Separator />
        <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S" />
        <MenuItem Header="Save _As..." Click="SaveAs_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Validate configuration" Click="Validate_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,28,0" Text="New configuration" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Validate" Click="Validate_Click" />
          <Button Content="Save" Click="Save_Click" Margin="0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24">
        <TextBlock Text="Installer configuration" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Enter the details of your application, then save the installer.json file." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap" />

        <GroupBox Header="Application" Margin="0,0,0,16">
          <StackPanel Margin="14">
            <TextBlock Text="Identifier" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" /><TextBox x:Name="ApplicationIdBox" />
            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ApplicationNameBox" />
            <TextBlock Text="Version" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VersionBox" />
            <TextBlock Text="Publisher" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PublisherBox" />
            <TextBlock Text="Executable" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ExecutableBox" ToolTip="Relative path inside the source folder, for example MyApp.exe" />
            <TextBlock Text="Icon (optional)" Style="{StaticResource FieldLabel}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="IconBox" /><Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseIcon_Click" /></Grid>
            <TextBlock Text="Welcome image (optional)" Style="{StaticResource FieldLabel}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="WelcomeImageBox" /><Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseWelcomeImage_Click" /></Grid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Files and installation" Margin="0,0,0,16">
          <StackPanel Margin="14">
            <TextBlock Text="Source folders" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <ItemsControl x:Name="SourceFoldersList" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Source folder to package, for example E:\Publish" />
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseSourceFolder_Click" />
                    <TextBox Grid.Column="2" Text="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="Installation destination: '.' or empty for the installation root, a relative subfolder, or an absolute path with {LocalAppData} and &lt;Application&gt;." />
                    <Button Grid.Column="3" Content="Remove" Margin="8,0,0,0" Click="RemoveSourceFolder_Click" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add source folder..." Margin="0,0,0,12" Click="AddSourceFolder_Click" />
            <TextBlock Text="Installation folder" Style="{StaticResource FieldLabel}" /><TextBox x:Name="InstallationDirectoryBox" ToolTip="Use {LocalAppData} and &lt;Application&gt; if desired." />
            <CheckBox x:Name="AllowDirectorySelectionBox" Content="Let the user choose the installation folder" Margin="0,12,0,0" />
            <TextBlock Text="License file" Style="{StaticResource FieldLabel}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="LicenseFileBox" /><Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseLicense_Click" /></Grid>
            <CheckBox x:Name="RequireAcceptanceBox" Content="Require license acceptance" Margin="0,12,0,0" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Shortcuts and generated file">
          <StackPanel Margin="14">
            <TextBlock Text="Shortcuts" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" /><StackPanel Orientation="Horizontal"><CheckBox x:Name="StartMenuBox" Content="Start menu" Margin="0,0,20,0" /><CheckBox x:Name="DesktopBox" Content="Desktop" /></StackPanel>
            <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="OutputDirectoryBox" /><Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseOutput_Click" /></Grid>
            <TextBlock Text="File name" Style="{StaticResource FieldLabel}" /><TextBox x:Name="OutputFileNameBox" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" Text="Example: MyApplication-Setup-1.0.0.exe" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
