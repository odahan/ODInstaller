<Window
    x:Class="OdInstaller.Setup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Setup"
    Width="660"
    Height="420"
    MinWidth="500"
    MinHeight="360"
    WindowStartupLocation="CenterScreen"
    Background="#121212"
    Foreground="#F1F1F1">

    <Window.Resources>
        <!-- Common button appearance. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D6CDF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4B88F5" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <!-- Installation directory input appearance. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- Option checkbox appearance. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F1F1" />
        </Style>

        <!-- License text container appearance. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- Compact dark scrollbar appearance. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Width" Value="12" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="2">
                            <Track
                                x:Name="PART_Track"
                                Orientation="{TemplateBinding Orientation}">
                                <Track.Thumb>
                                    <Thumb
                                        Background="#666666"
                                        BorderBrush="#888888"
                                        BorderThickness="1" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main content area. -->
        <Grid>
            <!-- Welcome page displayed when the wizard starts. -->
            <Grid
                x:Name="WelcomePanel"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition
                        x:Name="WelcomeImageRow"
                        Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="TitleText"
                    FontSize="25"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14"
                    TextAlignment="Center" />

                <Image
                    x:Name="WelcomeImage"
                    Grid.Row="1"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="BodyText"
                    Grid.Row="2"
                    MaxWidth="520"
                    Margin="0,0,0,24"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Standard content area used by the remaining wizard pages. -->
            <Grid x:Name="StandardPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="StandardTitleText"
                    Margin="0,0,0,16"
                    FontSize="24"
                    FontWeight="SemiBold" />

                <!-- License agreement page. -->
                <ScrollViewer
                    x:Name="LicensePanel"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="LicenseText"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <TextBlock
                    x:Name="StandardBodyText"
                    Grid.Row="1"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />

                <!-- Installation directory page. -->
                <TextBox
                    x:Name="DirectoryBox"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Visibility="Collapsed" />

                <!-- License and shortcut options. -->
                <StackPanel Grid.Row="2">
                    <CheckBox
                        x:Name="AcceptBox"
                        Margin="0,4,0,0"
                        Content="I accept the license agreement."
                        Visibility="Collapsed" />

                    <CheckBox
                        x:Name="StartMenuBox"
                        Margin="0,4,0,0"
                        Content="Create a Start menu shortcut."
                        Visibility="Collapsed" />

                    <CheckBox
                        x:Name="DesktopBox"
                        Margin="0,8,0,0"
                        Content="Create a desktop shortcut."
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Reserved for installation progress reporting. -->
                <ProgressBar
                    x:Name="Progress"
                    Grid.Row="2"
                    Height="20"
                    Margin="0,20,0,0"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Wizard navigation buttons. -->
        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                x:Name="BackButton"
                Width="90"
                Margin="0,0,8,0"
                Click="Back_Click"
                Content="Back" />

            <Button
                x:Name="NextButton"
                Width="90"
                Click="Next_Click"
                Content="Next" />
        </StackPanel>
    </Grid>
</Window>
