<Window x:Class="OdInstaller.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Setup" Width="660" Height="470" WindowStartupLocation="CenterScreen"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><ScrollViewer x:Name="LicensePanel" Height="230" Visibility="Collapsed"><TextBlock x:Name="LicenseText" TextWrapping="Wrap"/></ScrollViewer><TextBlock x:Name="BodyText" TextWrapping="Wrap"/><TextBox x:Name="DirectoryBox" Visibility="Collapsed" Margin="0,16,0,0"/><CheckBox x:Name="AcceptBox" Visibility="Collapsed" Content="I accept the license agreement." Margin="0,16,0,0"/><CheckBox x:Name="StartMenuBox" Visibility="Collapsed" Content="Create a Start menu shortcut." Margin="0,8,0,0"/><CheckBox x:Name="DesktopBox" Visibility="Collapsed" Content="Create a desktop shortcut." Margin="0,8,0,0"/><ProgressBar x:Name="Progress" Visibility="Collapsed" Height="20" Margin="0,20,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="Back" Width="90" Margin="0,0,8,0" Click="Back_Click"/><Button x:Name="NextButton" Content="Next" Width="90" Click="Next_Click"/></StackPanel></Grid></Window>
