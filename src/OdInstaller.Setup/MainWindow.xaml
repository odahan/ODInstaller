<Window x:Class="OdInstaller.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Setup" Width="660" Height="420" MinWidth="500" MinHeight="360" WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#F1F1F1">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#2D6CDF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B88F5"/><Setter Property="Padding" Value="12,6"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#252525"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="BorderBrush" Value="#555555"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F1F1F1"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid x:Name="WelcomePanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition x:Name="WelcomeImageRow" Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,14"/>
        <Image x:Name="WelcomeImage" Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>
        <TextBlock x:Name="BodyText" Grid.Row="2" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"/>
      </Grid>
      <StackPanel x:Name="StandardPanel">
        <TextBlock x:Name="StandardTitleText" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <ScrollViewer x:Name="LicensePanel" Height="230" Visibility="Collapsed"><TextBlock x:Name="LicenseText" TextWrapping="Wrap"/></ScrollViewer>
        <TextBlock x:Name="StandardBodyText" TextWrapping="Wrap"/>
        <TextBox x:Name="DirectoryBox" Visibility="Collapsed" Margin="0,16,0,0"/>
        <CheckBox x:Name="AcceptBox" Visibility="Collapsed" Content="I accept the license agreement." Margin="0,16,0,0"/>
        <CheckBox x:Name="StartMenuBox" Visibility="Collapsed" Content="Create a Start menu shortcut." Margin="0,8,0,0"/>
        <CheckBox x:Name="DesktopBox" Visibility="Collapsed" Content="Create a desktop shortcut." Margin="0,8,0,0"/>
        <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="20" Margin="0,20,0,0"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="Back" Width="90" Margin="0,0,8,0" Click="Back_Click"/><Button x:Name="NextButton" Content="Next" Width="90" Click="Next_Click"/></StackPanel>
  </Grid>
</Window>
